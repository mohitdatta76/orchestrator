# Required: Anthropic API key
ANTHROPIC_API_KEY=sk-ant...

# Required: directory where your personal data lives (outside the source tree)
# This is created and initialized automatically on first run.
# Example: DATA_DIR=/home/yourname/orchestrator-data
DATA_DIR=

# Optional: path to your MCP servers config file (default: mcp_servers.md).
# That file lists MCP servers to load additional skills from.
# MCP_SERVERS_FILE=mcp_servers.md

# Optional overrides (defaults shown)
# MODEL=claude-opus-4-6
# MAX_TOKENS=8096
# SKILLS_DIR=skills
# SYSTEM_PROMPT_FILE=system_prompt.md
